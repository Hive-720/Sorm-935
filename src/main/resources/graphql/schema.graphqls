type Query {
    request: QueryMessage!
    getSchema: String!
}

type QueryMessage {
    requestID: String!
    offline: Boolean!
    maxPageSize: Int

    users(filter: UserFilterInput!, offset: Int, limit: Int): UserResult!
    comments(filter: CommentFilterInput!, offset: Int, limit: Int): CommentResult!
}

input CommentFilterInput {
    and: [CommentFilterInput]
    or: [CommentFilterInput]
    not: CommentFilterInput
    userId: String
    text: String
}

input UserFilterInput {
    and: [UserFilterInput]
    or: [UserFilterInput]
    not: UserFilterInput
    name: String
    age: Int
}

type UserResult {
    hasNextPage: Boolean
    result: [User!]
}

type CommentResult {
    hasNextPage: Boolean
    result: [Comment!]
}

type User {
    id: String!
    name: String!
    comments(offset: Int, limit: Int): CommentResult!
}

type Comment {
    id: String!
    userId: String!
    text: String!
}

type Subscription {
    trap: Trap!
#    statusOfflineRequest(requestID: String!): String!
}

type Trap {
    type: TrapType!
    message: String
#    startsAt: DateTimeBase!
#    metricalerts: MetricAlerts
}

enum TrapType {
    RESTARTDB
    UNAUTHORIZEDACCESS
    CRITICALERROR
    MAJORERROR
    MINORERROR
    SCHEMCHANGED
    METRICALERTS
}

